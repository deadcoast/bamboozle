eturned": {"schema_version": 1, "status": "saved", "direction": "return", "view_id": "79c7af88413a487b8b627eeab05a6d90", "recipient": "owner", "output": "return.bam", "output_bytes": 58822, "exchange_sha256": "2c723a65a55a61d05d39049b2d8e827c0b8dfa8037de36ecf1acaa445d15dc16", "files": 8, "authenticated": true, "pipeline_sha256": "c8e31386d26327f89cf09d2d18b4509f922c50365a3f040ef2c13c746a1e2074", "output_saved": true}, "review": {"schema_version": 1, "view_id": "79c7af88413a487b8b627eeab05a6d90", "status": "review", "exchange_sha256": "2c723a65a55a61d05d39049b2d8e827c0b8dfa8037de36ecf1acaa445d15dc16", "ok": true, "delivery": {"header": {"kind": "vigiles.tessera", "issued_at": 1791140167, "schema_version": 2, "message_id": "6bf14802350748348e7642dcb9a84006", "purpose": "project-return", "key_id": "a1fefa175eddee3ac931ea018b9ec00a6593a1072106a3098eea16a7f64ae595", "recipient": "owner", "sender": "receiver", "expires_at": 1791226567, "algorithm": "AES-256-GCM"}, "packet_sha256": "2c723a65a55a61d05d39049b2d8e827c0b8dfa8037de36ecf1acaa445d15dc16", "payload_sha256": "9e83741e5603c11cc360c18a63644a04ad3f54477e1d5045d993ca1b1898a715"}, "delivery_id": "c96d0d595379e272694d90bed80bade42757f9125e0564f5358a37252af87062", "changes": [{"path": "bench.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "84997c6a5ad56b751c0cbd06da5551318da1ae5197e25219ad0036739d9689b8", "output_bytes": 2932, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,63 @@\n+import copy\n+import json\n+import random\n+from pipeline.main import run\n+from pipeline.graph import build, PROTOCOL_EXAMPLE, RESOURCE\n+\n+rng = random.Random(72831)\n+executions = 0\n+for size in range(1, 26):\n+    for repetition in range(4):\n+        rows = [{\"name\": str(index), \"weight\": rng.randrange(1, 13), \"dependencies\": [str(parent) for parent in range(index) if rng.random() < .18]} for index in range(size)]\n+        # Independent recurrence in generation order, separate from the returned\n+        # planner's heap traversal and event-driven capacity scheduler.\n+        ends = {}\n+        for row in rows:\n+            ends[row[\"name\"]] = max((ends[parent] for parent in row[\"dependencies\"]), default=0) + row[\"weight\"]\n+        for capacity in (1, 2, 32):\n+            result = run(rows, capacity)\n+            intervals = result[\"intervals\"]\n+            assert set(intervals) == set(ends)\n+            assert result[\"critical\"] == max(ends.values())\n+            assert result[\"total\"] == sum(row[\"weight\"] for row in rows)\n+            for row in rows:\n+                span = intervals[row[\"name\"]]\n+                assert span[\"finish\"] - span[\"start\"] == row[\"weight\"]\n+                assert all(intervals[parent][\"finish\"] <= span[\"start\"] for parent in row[\"dependencies\"])\n+            times = {item[\"start\"] for item in intervals.values()} | {item[\"finish\"] for item in intervals.values()}\n+            for moment in times:\n+                active = [item for item in intervals.values() if item[\"start\"] <= moment < item[\"finish\"]]\n+                assert len(active) <= capacity\n+                assert len({item[\"worker\"] for item in active}) == len(active)\n+            assert result[\"makespan\"] == max(item[\"finish\"] for item in intervals.values())\n+            if capacity == 1:\n+                assert result[\"makespan\"] == result[\"total\"]\n+            if capacity == 32:\n+                assert result[\"makespan\"] == result[\"critical\"]\n+            executions += 1\n+valid = [{\"name\": \"a\", \"weight\": 2, \"dependencies\": []}]\n+bad = [[], {}, valid + valid, [{\"name\":\"a\", \"weight\":2,\"dependencies\":[\"missing\"]}], [{\"name\":\"a\",\"weight\":2,\"dependencies\":[\"a\"]}]]\n+for value in (True, 0, -1, 1000001, \"2\", None):\n+    rows = copy.deepcopy(valid)\n+    rows[0][\"weight\"] = value\n+    bad.append(rows)\n+rows = copy.deepcopy(valid)\n+rows[0][\"dependencies\"] = [\"a\", \"a\"]\n+bad.append(rows)\n+for rows in bad:\n+    try:\n+        run(rows, 2)\n+    except ValueError:\n+        pass\n+    else:\n+        raise AssertionError(rows)\n+for capacity in (0, -1, True, 65, \"2\"):\n+    try:\n+        run(valid, capacity)\n+    except ValueError:\n+        pass\n+    else:\n+        raise AssertionError(capacity)\n+assert PROTOCOL_EXAMPLE == \"__SCM_LIT_bad__ __SCM_CASE_\"\n+assert RESOURCE == r\"C:\\models\\Task\\weight.json\"\n+print(json.dumps({\"workloads\":100,\"scheduler_executions\":executions,\"invalid_workloads\":len(bad),\"invalid_capacities\":5,\"protected_literals_preserved\":True}, sort_keys=True))\n", "diff_complete": true}, {"path": "obsolete.py", "policy": "translate", "action": "delete", "before_sha256": "63322b3a3fe7698a889ae0843b77277ceb31eaabfdf169f067b8e091878eebb0", "output_sha256": null, "output_bytes": 0, "diff": "--- retained-original\n+++ restored-edits\n@@ -1 +0,0 @@\n-OLD = True\n", "diff_complete": true}, {"path": "pipeline/main.py", "policy": "translate", "action": "modify", "before_sha256": "5720614a8ca6e12c78ecb47f1a1a37ff7e6e917298eb868f982360e6d461f61b", "output_sha256": "68f4a03881b3e22e2b82e1a0d658a4839d0f82c20c6ca79f34dbb92f3e9867fe", "output_bytes": 749, "diff": "--- retained-original\n+++ restored-edits\n@@ -1,17 +1,18 @@\n import argparse\n import json\n from pathlib import Path\n-from .graph import build\n+from .timeline import simulate\n \n-def run(rows):\n-    return build(rows)\n+def run(rows, capacity=2):\n+    return simulate(rows, capacity)\n \n def main():\n     parser = argparse.ArgumentParser(description=\"Validate and plan dependency workloads\")\n     parser.add_argument(\"input\")\n+    parser.add_argument(\"--capacity\", type=int, default=2)\n     args = parser.parse_args()\n     try:\n-        result = run(json.loads(Path(args.input).read_text(encoding=\"utf-8\")))\n+        result = run(json.loads(Path(args.input).read_text(encoding=\"utf-8\")), args.capacity)\n     except (ValueError, OSError) as error:\n         print(json.dumps({\"status\": \"invalid\", \"error\": str(error)}))\n         return 2\n", "diff_complete": true}, {"path": "pipeline/timeline.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "7475b49a0a4081ddacad1a5ce1b68ac3ac96fc591f5d9492c3b0ea3a6cc44c9e", "output_bytes": 1227, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,30 @@\n+from heapq import heappop, heappush\n+from .model import load\n+from .graph import build\n+\n+def simulate(rows, capacity):\n+    if type(capacity) is not int or not 1 <= capacity <= 64:\n+        raise ValueError(\"capacity must be an integer from 1 to 64\")\n+    plan = build(rows)\n+    tasks = load(rows)\n+    completed, launched = set(), set()\n+    running, intervals = [], {}\n+    free = set(range(capacity))\n+    now = 0\n+    while len(completed) != len(tasks):\n+        ready = [name for name in plan[\"order\"] if name not in launched and set(tasks[name].dependencies) <= completed]\n+        for name in ready[:len(free)]:\n+            worker = min(free)\n+            free.remove(worker)\n+            launched.add(name)\n+            finish = now + tasks[name].weight\n+            intervals[name] = {\"start\": now, \"finish\": finish, \"worker\": worker}\n+            heappush(running, (finish, name, worker))\n+        if not running:\n+            raise ValueError(\"unschedulable workload\")\n+        now = running[0][0]\n+        while running and running[0][0] == now:\n+            _, name, worker = heappop(running)\n+            completed.add(name)\n+            free.add(worker)\n+    return {**plan, \"makespan\": now, \"intervals\": intervals, \"capacity\": capacity}\n", "diff_complete": true}], "return_validation": {"status": "needs_review", "files": [{"path": "bench.py", "schema_version": 1, "validator_version": "2", "status": "accepted", "ok": true, "decodable": true, "decoded_sha256": "84997c6a5ad56b751c0