"][key], key))\n+    return result\n", "diff_complete": true}, {"path": "tests/test_summary.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "ba7b8ff55f1314ea2fb534fd704e83434edf09e8c66784f6909559653c2b2238", "output_bytes": 856, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,19 @@\n+import unittest\n+from app.summary import rank\n+\n+class Ranking(unittest.TestCase):\n+    def test_ranked_workloads(self):\n+        for size in range(60):\n+            rows = [{\"id\": str(i), \"group\": \"g\" + str(i % 4), \"amount\": i} for i in range(size)]\n+            report = rank(rows, 2)\n+            self.assertEqual(report[\"total\"], sum(range(size)) * 2)\n+            self.assertEqual(report[\"ranking\"], sorted(report[\"groups\"], key=lambda key: (-report[\"groups\"][key], key)))\n+\n+    def test_ties_and_empty(self):\n+        rows = [{\"id\": key, \"group\": key, \"amount\": 4} for key in (\"b\", \"a\")]\n+        self.assertEqual(rank(rows, 2)[\"ranking\"], [\"a\", \"b\"])\n+        self.assertEqual(rank([], 2)[\"ranking\"], [])\n+\n+    def test_dependency_rejects_invalid(self):\n+        with self.assertRaises(ValueError):\n+            rank([{\"id\": \"x\", \"group\": \"g\", \"amount\": True}], 2)\n", "diff_complete": true}], "return_validation": {"status": "needs_review", "files": [{"path": "app/__init__.py", "schema_version": 1, "validator_version": "2", "status": "accepted", "ok": true, "decodable": true, "decoded_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "decode_policy": "saved_mapping_reserved_targets_before_manual_intent_decisions", "edited_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "baseline_encoded_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "dictionary_sha256": "0bdc79b262fda8eabd1baf33b39bd2c8b4e0e3a3a70bc9cdf0e4cf90c3d5f841", "document_rules": {"format": "text"}, "context_sha256": "ca3d163bab05538