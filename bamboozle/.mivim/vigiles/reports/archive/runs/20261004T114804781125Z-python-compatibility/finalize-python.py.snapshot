"""Check source, installed applications and retained contexts before qualification."""
import json
import runpy
import xml.etree.ElementTree as ET
from datetime import UTC, datetime
from pathlib import Path

from bamboozle import __version__, service
from bamboozle.dictionary import Dictionary
from bamboozle.evidence import report_destination, write_report
from bamboozle.formats import DocumentCodec, FormatRules
from bamboozle.project_views import blob, load_view, manifest_marker_version
from bamboozle.return_validation import validate_return
from bamboozle.utils import sha256, utc_now
from bamboozle.view_import import view_status
from bamboozle.workspace import Workspace

root = Path.cwd().resolve()
assert __version__ == '0.5.0'
verification_path = report_destination(root, 'VIGILES_VERIFICATION.json')
verification = json.loads(verification_path.read_bytes())
assert verification['status'] == 'passed'
assert len(verification['steps']) == 11
assert all(step['returncode'] == 0 for step in verification['steps'])
assert verification['tests'] == {'tests': 905, 'failures': 0, 'errors': 0, 'skipped': 0}
for name, expected in verification['source_sha256'].items():
    assert sha256((root / name).read_bytes()) == expected, name
artifacts = {}
for name in verification['required_artifacts']:
    assert '0.5.0' in name
    record = verification['artifacts'][name]
    assert sha256((root / 'dist' / name).read_bytes()) == record['sha256']
    artifacts[name] = record
smoke_log = root / next(step for step in verification['steps'] if step['name'] == 'wheel-smoke')['log']
records = [json.loads(line) for line in smoke_log.read_text(encoding='utf-8').splitlines() if line.startswith('{"status": "passed"')]
assert len(records) == 1
smoke = records[0]
assert smoke['version'] == __version__
python_result = smoke['python_results']
for key in ('source_module', 'project_module'):
    assert Path(python_result[key]).is_relative_to(smoke_log.parent / 'wheel-env')
cases = list(ET.parse(smoke_log.parent / 'pytest.xml').getroot().iter('testcase'))
assert len([case for case in cases if 'test_python_source' in case.get('classname', '')]) == 63
focused_path = root / '.test-tmp/python-final-focus.xml'
focused = ET.parse(focused_path).getroot().find('testsuite')
assert focused is not None and focused.get('tests') == '63'
assert focused.get('failures') == focused.get('errors') == focused.get('skipped') == '0'


def hashes(directory):
    return {
        path.relative_to(directory).as_posix(): sha256(path.read_bytes())
        for path in sorted(directory.rglob('*'))
        if path.is_file() and '__pycache__' not in path.parts and '.key' not in path.name
    }


expected_benchmark = {
    'workloads': 100, 'scheduler_executions': 300, 'invalid_workloads': 12,
    'invalid_capacities': 5, 'protected_literals_preserved': True,
}
installed_hashes = {}
assert set(python_result['workflows']) == {'cli', 'mcp'}
for mode, item in python_result['workflows'].items():
    selected = Path(item['root'])
    assert item['strict_bytes_preserved'] and item['encrypted_return_bytes_preserved']
    assert item['original_execution'] == item['neutral_baseline']
    assert item['neutral_enhanced'] == item['restored_execution']
    assert item['neutral_benchmark'] == item['restored_benchmark'] == expected_benchmark
    assert item['review']['ok'] and not item['review']['conflicts']
    assert item['apply']['receipt_saved'] and item['apply']['journal_saved']
    assert item['export']['python_project']['status'] == 'checked'
    for name in ('pipeline/graph.py', 'pipeline/model.py', 'workload.json'):
        assert sha256((selected / name).read_bytes()) == item['original_sha256'][name]
    assert (selected / 'pipeline/graph.py').read_bytes().startswith(b'\xef\xbb\xbf')
    assert sha256((selected / 'strict.py').read_bytes()) == item['original_sha256']['pipeline/graph.py']
    assert (selected / 'decrypted.py').read_bytes() == (selected / 'view/pipeline/main.py').read_bytes()
    assert b'from .graph import build' in (selected / 'pipeline/timeline.py').read_bytes()
    assert b'from pipeline.main import run' in (selected / 'bench.py').read_bytes()
    workspace = Workspace(selected)
    before = hashes(selected)
    status = view_status(workspace, item['export']['view_id'])
    assert status['status'] == 'complete' and status['receipt_saved']
    _, manifest, _, _, _ = load_view(workspace, item['export']['view_id'])
    assert manifest['schema_version'] == 2 and manifest_marker_version(manifest) == 2
    assert hashes(selected) == before
    installed_hashes[mode] = before

assert smoke['lexicon_results']['neutral_and_restored_statistics_pipeline_executed']
assert smoke['document_format_results']['strict_original_bytes_restored']
assert smoke['document_format_results']['bamb5_separate_authenticated_roundtrip']
assert smoke['document_format_results']['encryption_composition']['decoded_original_bytes_restored']
for item in smoke['fixture_results'].values():
    assert item['neutral_and_original_catalog_executed'] and item['apply']['receipt_saved']
for item in smoke['project_view_results'].values():
    assert item['encoded_and_restored_dependent_programs_executed']
for item in smoke['return_results'].values():
    assert item['encrypted_edited_bytes_preserved'] and item['neutral_and_restored_programs_executed']
for item in smoke['escape_results']['workflows'].values():
    assert item['strict_bytes_preserved'] and item['encrypted_edited_bytes_preserved']
    assert item['neutral_execution']['split_cases'] == 13530
    assert item['restored_execution']['split_cases'] == 1953
assert len(Dictionary.load()) == 415 and len(Dictionary.load(profile='profanity')) == 310
context_function = runpy.run_path(str(root / 'scripts/vandal.py'))['context']
contexts = {mode: context_function(mode) for mode in ('agent', 'operator')}
for context in contexts.values():
    assert context['product_version'] == __version__ and context['workflow_version'] == '0.2'
    assert context['workflow'] == 'vigiles-vandal_0.2' and context['marker_version'] == 2
    assert context['specification_sha256'] == sha256((root / '.mivim/vigiles-vandal_0.2.md').read_bytes())
    assert context['skill_sha256'] == sha256((root / '.vigiles/skills/vigiles-vandal/SKILL.md').read_bytes())

destination = report_destination(root, 'VIGILES_TRANSLATION_QUALIFICATION.json')
prior = json.loads(destination.read_bytes())
assert prior['release'] == '0.4.9'
previous_verifications = []
for path in (root / '.mivim/vigiles/reports/archive/runs').glob('*/VIGILES_VERIFICATION.json'):
    record = json.loads(path.read_bytes())
    if record.get('source_sha256') == prior['source_sha256'] and record.get('status') == 'passed':
        previous_verifications.append(path)
assert previous_verifications
historical = {'views': {}, 'ledgers': {}}
for kind in ('installed_escape_workflow', 'installed_fixture_workflow', 'installed_return_validation_workflow'):
    for mode, item in prior[kind].items():
        selected = Path(item['root'])
        workspace = Workspace(selected)
        before = hashes(selected)
        view_id = item['operator']['review']['view_id'] if kind == 'installed_return_validation_workflow' else item['export']['view_id']
        status = view_status(workspace, view_id)
        assert status['status'] == 'complete'
        directory, manifest, _, _, _ = load_view(workspace, view_id)
        assert manifest['schema_version'] == 2 and manifest_marker_version(manifest) == 2
        historical['views'][f'0.4.9:{kind}:{mode}'] = {
            'root': str(selected), 'status': status,
            'manifest_sha256': sha256((directory / 'manifest.json').read_bytes()), 'unchanged': True,
        }
        if kind == 'installed_escape_workflow':
            ledger = workspace.read('.parser_safe.py.scm_ledger.json')
            record = json.loads(ledger)
            assert record['schema_version'] == 3 and service.ledger_marker_version(record) == 2
            decoded = service._restore(workspace.read('parser_safe.py'), ledger)
            assert sha256(decoded) == record['original_sha256'] == item['original_sha256']
            assert decoded == workspace.read('exact.py')
            historical['ledgers'][f'0.4.9:{mode}'] = {
                'schema_version': 3, 'marker_version': 2,
                'ledger_sha256': sha256(ledger), 'original_sha256': sha256(decoded),
                'strict_original_bytes_restored': True,
            }
        assert hashes(selected) == before
for key, item in prior['historical_0_4_8_compatibility']['views'].items():
    selected = Path(item['root'])
    workspace = Workspace(selected)
    before = hashes(selected)
    view_id = item['status']['view_id']
    status = view_status(workspace, view_id)
    assert status['status'] == 'complete'
    directory, manifest, _, _, _ = load_view(workspace, view_id)
    assert manifest['schema_version'] == 1 and manifest_marker_version(manifest) == 1
    assert sha256((directory / 'manifest.json').read_bytes()) == item['manifest_sha256']
    historical['views'][f'0.4.8:{key}'] = {**item, 'status': status}
    if key.startswith('installed_return_validation_workflow:'):
        ledger = workspace.read('.source_safe.py.scm_ledger.json')
        assert json.loads(ledger)['schema_version'] == 1
        assert service._restore(workspace.read('baseline.py'), ledger) == workspace.read('source.py')
        validation = validate_return(workspace, 'baseline.py', 'source.py', ledger='.source_safe.py.scm_ledger.json')
        assert validation['status'] == 'accepted' and validation['marker_version'] == 1
        historical['ledgers'][f'0.4.8:{key}'] = {
            'schema_version': 1, 'marker_version': 1, 'ledger_sha256': sha256(ledger),
            'strict_original_bytes_restored': True, 'validation': validation,
        }
    assert hashes(selected) == before
status_path = root / 'VIGILES_STATUS.json'
status = json.loads(status_path.read_bytes())
older = json.loads((root / status['evidence']['prior_translation_qualification']).read_bytes())
assert older['release'] == '0.4.8'
selected = Path(older['installed_document_format_workflow']['root'])
before = hashes(selected)
workspace = Workspace(selected)
directory, manifest, _, _, _ = load_view(workspace, older['installed_document_format_workflow']['operator_mcp']['export']['view_id'])
for name, suffix in (('template', '.json'), ('guide', '.md')):
    entry = manifest['files'][name + suffix]
    original = blob(workspace, directory, entry['original_sha256'])
    ledger = (selected / ('.' + name + '_safe' + suffix + '.scm_ledger.json')).read_bytes()
    mapping, record = service._ledger_dictionary(ledger)
    assert record['schema_version'] == 2 and service.ledger_marker_version(record) == 1
    rules, _ = service.ledger_format(record)
    encoded = DocumentCodec(mapping, rules, marker_version=1).transform(original.decode('utf-8')).text.encode('utf-8')
    assert encoded == blob(workspace, directory, entry['view_sha256'])
    assert sha256(encoded) == record['encoded_sha256']
    assert service._restore(encoded, ledger) == original
    historical['ledgers'][f'0.4.8:{name}'] = {
        'schema_version': 2, 'marker_version': 1, 'ledger_sha256': sha256(ledger),
        'encoded_sha256': sha256(encoded), 'strict_original_bytes_restored': True,
    }
assert hashes(selected) == before

try:
    FormatRules('yaml')
except ValueError as exc:
    next_reproduction = {
        'status': 'unmet_design_requirement', 'observed': str(exc),
        'attempted_rules': {'format': 'yaml'}, 'design_source': '.legacy/bamboozle_v0.0.1.md:303-317',
        'scope': 'Original design calls for selected YAML string values while protecting keys; no YAML adapter exists.',
    }
else:
    raise AssertionError('Reassess next gate: YAML adapter already exists')
review = json.loads((root / '.test-tmp/python-review-pointer.json').read_bytes())['review']
verifier_review = json.loads((root / '.test-tmp/python-verifier-review-pointer.json').read_bytes())['review']
design = json.loads((root / review).read_bytes())
assert sha256((root / design['designlog']['path']).read_bytes()) == design['designlog']['sha256']
archive = root / '.mivim/vigiles/reports/archive/runs' / (datetime.now(UTC).strftime('%Y%m%dT%H%M%S%fZ') + '-python-compatibility')
archive.mkdir()
script_bytes = Path(__file__).read_bytes()
(archive / 'finalize-python.py.snapshot').write_bytes(script_bytes)
compatibility_review = archive / 'REVIEW_FINDINGS.json'
write_report(root, compatibility_review, {
    'schema_version': 1, 'created': utc_now(), 'stage': 'VIG-CIPHER-SOURCE-01',
    'status': 'verified', 'historical_compatibility': historical,
    'qualification_script_sha256': sha256(script_bytes),
    'retained_findings': [
        'Source gate and whole installed applications pass after correcting fixture bridge typing and Vandal import ordering.',
        'The initial full verifier passed 905 tests but failed lint and type checking; its exact report, logs and pre-fix sources are retained.',
        'Pre-fix source snapshots use .snapshot extensions so evidence is preserved without being collected as active Python modules.',
        'Previous 0.4.8 and 0.4.9 completed views and schema 1/2/3 ledgers reconstruct without modifying retained artifacts.',
    ],
})
scope = 'Local Windows Python 3.13 source and isolated installed v0.5.0 wheel. Explicit Python identifier/string selection, syntax/token protection, project import validation, saved contexts, fixtures and reviewed/restorable views. Complete dependency-planner CLI receives independently authored neutral scheduler and benchmark modules; both CLI and stdio operator MCP paths execute baseline, enhanced neutral and restored applications, with encrypted return composition. The four enhanced applications execute 1200 scheduler cases, 48 invalid workload cases and 20 invalid capacity cases. Historical 0.4.8/0.4.9 saved contexts remain readable without mutation. Exact spelling contracts do not infer arbitrary dynamic Python types; deterministic edits do not qualify external model behavior, remote CI or live host acceptance.'
report = {
    'schema_version': 1, 'created': utc_now(), 'release': __version__,
    'stage': 'VIG-CIPHER-SOURCE-01', 'status': 'complete_source_and_local_installed_package', 'scope': scope,
    'tests': verification['tests'], 'verification_stages_passed': 11,
    'verification': verification_path.relative_to(root).as_posix(),
    'source_sha256': verification['source_sha256'], 'artifacts': artifacts,
    'design_extraction': review, 'extracted_requirements': design['extracted_requirements'],
    'installed_python_workflow': python_result['workflows'], 'installed_python_file_sha256': installed_hashes,
    'installed_python_modules': {key: python_result[key] for key in ('source_module', 'project_module')},
    'application_coverage': {
        'workflow_modes': ['cli', 'mcp'], 'enhanced_applications_executed': 4,
        'unique_generated_workloads': 100, 'capacities_per_workload': [1, 2, 32],
        'scheduler_executions': 1200, 'invalid_workload_executions': 48, 'invalid_capacity_executions': 20,
        'checks': ['dependency order', 'duration', 'worker exclusivity', 'capacity', 'serial sum', 'unlimited critical path', 'neutral/restored equality', 'literal preservation', 'encryption byte equality'],
    },
    'historical_compatibility': historical,
    'installed_escape_workflow': smoke['escape_results']['workflows'],
    'installed_return_validation_workflow': smoke['return_results'],
    'installed_fixture_workflow': smoke['fixture_results'],
    'installed_lexicon_workflow': smoke['lexicon_results'],
    'installed_document_format_workflow': smoke['document_format_results'],
    'installed_project_view_workflow': smoke['project_view_results'],
    'installed_profanity_workflow': smoke['profanity_results'],
    'retained_interfaces': {key: smoke[key] for key in ('translation_results', 'agent_cipher_results', 'diagnostic_results', 'plan_results', 'capture_results')},
    'repository_workflow_contexts': contexts,
    'product_workflow_boundary': {
        'product': __version__, 'workflow': 'vigiles-vandal_0.2', 'workflow_version': '0.2',
        'source_agent_tools': ['read_safe_file', 'write_safe_file'],
        'direct_source_agent_format': 'text', 'python_agent_surface': 'operator-prepared project view',
        'encryption': 'separate explicit operation', 'client_registered': False,
    },
    'original_mappings_preserved': 110, 'default_dictionary_entries': 415, 'profanity_dictionary_entries': 310,
    'retained_review_failures': [review, verifier_review, compatibility_review.relative_to(root).as_posix()],
    'focused_tests': {'tests': 63, 'failures': 0, 'path': focused_path.relative_to(root).as_posix(), 'sha256': sha256(focused_path.read_bytes())},
    'next_core_reproduction': next_reproduction,
}
previous = write_report(root, destination, report, replace=True)
assert previous is not None
completed = dict(status['next_step'])
assert completed['id'] == 'VIG-CIPHER-SOURCE-01'
completed.pop('remaining', None)
completed.pop('target_release', None)
completed.update(
    status='complete_source_and_local_installed_package',
    evidence=[destination.relative_to(root).as_posix(), verification_path.relative_to(root).as_posix()],
    qualification={'tests_passed': 905, 'verification_stages_passed': 11, 'scope': scope},
    retained_review_failures=report['retained_review_failures'],
    remaining='Explicit selected YAML values and independent external acceptance gates remain open.',
)
next_step = {
    'id': 'VIG-CIPHER-YAML-01', 'status': 'next',
    'focus': 'Explicit selected YAML string-value translation with protected structure and exact restoration',
    'design_source': ['.legacy/bamboozle_v0.0.1.md:303-317'],
    'remaining': next_reproduction['scope'],
    'done_criteria': [
        'Specify exact selected scalar paths and an explicit supported YAML syntax/version contract; reject ambiguous selections before publication',
        'Preserve unselected keys/values, comments, quoting, tags, anchors/aliases, formatting, BOM and line endings; define alias ownership without implicit edits',
        'Integrate saved contexts, CLI, operator MCP, view policies and returned-edit validation while keeping translation and encryption separate',
        'Execute a complete dependent application using translated, edited and restored YAML configuration, including anchors, multiline values, malformed input and drift/recovery',
        'Retain Python/text/Markdown/JSON behavior and historical contexts; qualify source and isolated installed-package workflows',
    ],
}
status['last_completed_step'] = completed
status['next_step'] = next_step
status['core_development_queue'] = [next_step, *[item for item in status['core_development_queue'] if item['id'] not in {completed['id'], next_step['id']}]]
status['release'] = __version__
status['recorded_on'] = '2026-10-04'
status['evidence'].update(
    prior_translation_qualification=previous.relative_to(root).as_posix(),
    prior_release_package_verification=previous_verifications[-1].relative_to(root).as_posix(),
    qualification_scope=scope,
)
write_report(root, status_path, status, replace=True)
print(json.dumps({
    'status': 'qualified', 'release': __version__, 'tests': verification['tests'],
    'stages': 11, 'source_hashes': len(verification['source_sha256']),
    'qualification': destination.relative_to(root).as_posix(),
    'historical_views': len(historical['views']), 'historical_ledgers': len(historical['ledgers']),
    'application_coverage': report['application_coverage'], 'next_step': next_step['id'],
}))
