alibration probe to {actor_b!s} for {duration:.1f} seconds at {{station}}.\\nConfirm {actor_a}.\",\n      \"role_order\": [\n        \"actor_a\",\n        \"actor_b\"\n      ],\n      \"roles\": [\n        \"actor_a\",\n        \"actor_b\"\n      ],\n      \"variables\": [\n        \"actor_a\",\n        \"actor_b\",\n        \"duration\"\n      ],\n      \"version\": 1\n    },\n    {\n      \"category\": \"calibration\",\n      \"constraints\": {\n        \"ordered\": true,\n        \"participant_count\": 2\n      },\n      \"duration\": 2.5,\n      \"id\": \"template_018\",\n      \"links\": [],\n      \"notes\": \"Use the calibration bench.\",\n      \"prompt\": \"Operator {actor_a} transfers a calibration probe to {actor_b!s} for {duration:.1f} seconds at {{station}}.\\nConfirm {actor_a}.\",\n      \"role_order\": [\n        \"actor_a\",\n        \"actor_b\"\n      ],\n      \"roles\": [\n        \"actor_a\",\n        \"actor_b\"\n      ],\n      \"variables\": [\n        \"actor_a\",\n        \"actor_b\",\n        \"duration\"\n      ],\n      \"version\": 1\n    }\n  ]\n}\n", "preview_complete": true, "contract_preview": "# Template processing contract\n\nThese neutral records preserve declared software invariants, not production scene semantics.\nFixture edits and cases must never replace production template text.\nGenerated contract/case files must remain unchanged; create separate test files for new cases.\n\nValidate a fixture with `bamboozle fixture-validate PATH --contract TEMPLATE_CONTRACT.json`.\n`TEMPLATE_CASES.json` supplies complete documents and expected invariant codes; an empty list means valid.\nConsumer symbols and field responsibilities are operator-declared and checked against parsed Python source, not inferred behavior.\n\n## templates.json\n\nRecords: `/templates`; stable ID: `/id`.\n\n### Field definitions and checks\n\n```json\n{\n  \"checks\": [\n    {\n      \"id\": \"version\",\n      \"kind\": \"type\",\n      \"minimum\": 1,\n      \"path\": \"/version\",\n      \"required\": true,\n      \"type\": \"integer\"\n    },\n    {\n      \"id\": \"duration\",\n      \"kind\": \"type\",\n      \"maximum\": 60,\n      \"minimum\": 0,\n      \"path\": \"/duration\",\n      \"required\": true,\n      \"type\": \"number\"\n    },\n    {\n      \"array\": \"/roles\",\n      \"count\": \"/constraints/participant_count\",\n      \"id\": \"roles\",\n      \"kind\": \"count\"\n    },\n    {\n      \"array\": \"/variables\",\n      \"id\": \"variables\",\n      \"kind\": \"variables\",\n      \"text\": \"/prompt\"\n    },\n    {\n      \"equals\": true,\n      \"id\": \"ordered\",\n      \"kind\": \"requires\",\n      \"then\": [\n        \"/role_order\"\n      ],\n      \"when\": \"/constraints/ordered\"\n    },\n    {\n      \"enum\": [\n        \"calibration\",\n        \"inspection\"\n      ],\n      \"id\": \"category\",\n      \"kind\": \"type\",\n      \"min_length\": 1,\n      \"path\": \"/category\",\n      \"required\": true,\n      \"type\": \"string\"\n    }\n  ],\n  \"document_preserve\": [\n    \"/label\"\n  ],\n  \"preserve\": [\n    \"/id\",\n    \"/category\",\n    \"/variables/*\",\n    \"/roles/*\",\n    \"/role_order/*\",\n    \"/links/*\"\n  ],\n  \"references\": [\n    {\n      \"many\": true,\n      \"optional\": false,\n      \"path\": \"/links\"\n    }\n  ],\n  \"text\": {\n    \"/notes\": {\n      \"optional\": true,\n      \"syntax\": \"none\",\n      \"template\": \"Use the calibration bench.\",\n      \"variants\": {}\n    },\n    \"/prompt\": {\n      \"optional\": false,\n      \"syntax\": \"format\",\n      \"template\": \"Operator {actor_a} transfers a calibration probe to {actor_b!s} for {duration:.1f} seconds at {{station}}.\\nConfirm {actor_a}.\",\n      \"variants\": {}\n    }\n  }\n}\n```\n\n### Processing call paths\n\n- `src/renderer.py:1` / `fuck`: Interpolate each record's named variables with its declared format specifiers. Fields: [\n  \"/prompt\",\n  \"/variables\"\n]\n\n### Verified cases\n\n- `baseline`: valid\n- `zero_duration`: valid\n- `missing_duration`: duration\n- `wrong_variables`: variables\n- `role_count`: roles\n- `ordered_roles`: ordered\n- `dangling_reference`: @reference\n- `boolean_version`: version\n", "contract_complete": true, "cases": [{"name": "baseline", "expect": []}, {"name": "zero_duration", "expect": []}, {"name": "missing_duration", "expect": ["duration"]}, {"name": "wrong_variables", "expect": ["variables"]}, {"name": "role_count", "expect": ["roles"]}, {"name": "ordered_roles", "expect": ["ordered"]}, {"name": "dangling_reference", "expect": ["@reference"]}, {"name": "boolean_version", "expect": ["version"]}], "output_saved": false}, "export": {"schema_version": 1, "view_id": "9fca56ea0c7b494ebacec0e31afed98b", "view": "neutral", "private_state": ".local/bamboozle/views/9fca56ea0c7b494ebacec0e31afed98b", "selected_source_files": 2, "excluded_files": [], "unselected_files": "omitted", "files_exported": 6, "manifest_saved": true, "status": "exported", "manifest_sha256": "cd4a3926a48a372e640155da1cccea892f609fdf5d1900306cff84128d3e414d"}, "review": {"schema_version": 1, "view_id": "9fca56ea0c7b494ebacec0e31afed98b", "status": "review", "ok": true, "changes": [{"path": "src/catalog.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "209b39ed8c62ba94d9b76abe959bf44033335cb89d972b51df712ba31e897209", "output_bytes": 2517, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,52 @@\n+from math import isfinite\r\n+from string import Formatter\r\n+from renderer import fuck\r\n+\r\n+class CatalogError(ValueError):\r\n+    def __init__(self, codes):\r\n+        self.codes = sorted(set(codes))\r\n+        super().__init__(\", \".join(self.codes))\r\n+\r\n+def compile_catalog(document, values):\r\n+    records = document.get(\"templates\")\r\n+    if not isinstance(records, list) or not records:\r\n+        raise CatalogError([\"@records\"])\r\n+    ids = [record.get(\"id\") for record in records]\r\n+    if any(not isinstance(value, str) or not value for value in ids) or len(set(ids)) != len(ids):\r\n+        raise CatalogError([\"@id\"])\r\n+    errors = []\r\n+    for record in records:\r\n+        version = record.get(\"version\")\r\n+        if type(version) is not int or version < 1:\r\n+            errors.append(\"version\")\r\n+        duration = record.get(\"duration\")\r\n+        if type(duration) not in (int, float) or not isfinite(duration) or not 0 <= duration <= 60:\r\n+            errors.append(\"duration\")\r\n+        constraints = record.get(\"constraints\", {})\r\n+        roles = record.get(\"roles\")\r\n+        if not isinstance(roles, list) or type(constraints.get(\"participant_count\")) is not int or len(roles) != constraints[\"participant_count\"]:\r\n+            errors.append(\"roles\")\r\n+        if constraints.get(\"ordered\") is True and \"role_order\" not in record:\r\n+            errors.append(\"ordered\")\r\n+        if record.get(\"category\") not in (\"calibration\", \"inspection\"):\r\n+            errors.append(\"category\")\r\n+        declared = record.get(\"variables\")\r\n+        try:\r\n+            fields = {field for _, field, _, _ in Formatter().parse(record[\"prompt\"]) if field is not None}\r\n+            if not isinstance(declared, list) or any(not isinstance(value, str) for value in declared) or len(set(declared)) != len(declared) or set(declared) != fields:\r\n+                errors.append(\"variables\")\r\n+        except (KeyError, ValueError, TypeError):\r\n+            errors.append(\"variables\")\r\n+        links = record.get(\"links\")\r\n+        if not isinstance(links, list) or any(link not in ids for link in links):\r\n+            errors.append(\"@reference\")\r\n+    if errors:\r\n+        raise CatalogError(errors)\r\n+    result = []\r\n+    for record in records:\r\n+        bindings = {**values, \"duration\": record[\"duration\"]}\r\n+        missing = set(record[\"variables\"]) - bindings.keys()\r\n+        if missing:\r\n+            raise CatalogError([\"bindings\"])\r\n+        result.append({\"id\": record[\"id\"], \"text\": fuck(record, bindings), \"links\": record[\"links\"]})\r\n+    return result\r\n", "diff_complete": true}, {"path": "src/renderer.py", "policy": "translate", "action": "modify", "before_sha256": "16fdc061ab0c2f8ac6d813cc9ca471dc722c5b7bba5c72f69a3531c355ab04e3", "output_sha256": "61af502b9ed7f66e455b3d052501684169f61c9f661c505fd98887a1fad3a94a", "output_bytes": 75, "diff": "--- retained-original\n+++ restored-edits\n@@ -1,2 +1,2 @@\n def fuck(record, values):\r\n-    return record['prompt'].format_map(values)\r\n+    return record[\"prompt\"].format_map(values)\r\n", "diff_complete": true}, {"path": "src/run_catalog.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "ba7b9877b314a87c188671b6004bc423dd7300974609fe8b8c98d28feccebb40", "output_bytes": 1129, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,27 @@\n+import json\r\n+import sys\r\n+from pathlib import Path\r\n+from catalog import CatalogError, compile_catalog\r\n+\r\n+cases = json.loads(Path(sys.argv[1]).read_bytes())[\"fixtures\"][\"templates.json\"]\r\n+bindings = {\"actor_a\": \"Ada\", \"actor_b\": \"Lin\"}\r\n+for case in cases:\r\n+    try:\r\n+        result = compile_catalog(case[\"document\"], bindings)\r\n+    except CatalogError as error:\r\n+        assert error.codes == case[\"expect\"], (case[\"name\"], error.codes, case[\"expect\"])\r\n+    else:\r\n+        assert not case[\"expect\"], case[\"name\"]\r\n+        assert [row[\"id\"] for row in result] == [\"template_017\", \"template_018\"]\r\n+        assert result[0][\"text\"].count(\"Ada\") == 2\r\n+        assert \"Lin\" in result[0][\"text\"] and \"{station}\" in result[0][\"text\"]\r\n+        assert result[0][\"links\"] == [\"template_018\"]\r\n+production = json.loads(Path(\"templates.json\").read_bytes())\r\n+assert len(compile_catalog(production, bindings)) == 2\r\n+try:\r\n+    compile_catalog(production, {\"actor_a\": \"Ada\"})\r\n+except CatalogError as error:\r\n+    assert error.codes == [\"bindings\"]\r\n+else:\r\n+    raise AssertionError(\"Missing runtime binding accepted\")\r\n+print(\"catalog-pipeline-ok\")\r\n", "diff_complete": true}], "return_validation": {"status": "needs_review", "files": [{"path": "src/catalog.py", "schema_version": 1, "validator_version": "2", "status": "needs_review", "ok": false, "decodable": true, "decoded_sha256": "209b39ed8c62ba94d9b76abe959bf44033335cb89d972b51df712ba31e897209", "decode_policy": "saved_mapping_reserved_targets_before_manual_intent_decisions", "edited_sha256": "25df93d6223d4f9909b6b64e9a48988aea3ce97dcd9573c534d80ea5396ac27f", "baseline_encoded_sha256": null, "dictionary_sha256": "3b4e57e2e14290c077405735dbeb75dc9109ba288bd5bd75d89f30667606562e", "document_rules": {"format": "text"}, "context_sha256": "ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356", "document_byte_limit": 16777216, "marker_version": 2, "validation_sha256": "9279e3803d573b7ae63bc6f9ff468a2f062bcc414a3be16bb0a1dda89f6d2bc7", "baseline_available": false, "analysis_complete": true, "finding_count": 2, "counts": {"ambiguous_target": 2}, "findings": [{"index": 0, "code": "ambiguous_target", "message": "Changed-line unmarked target will reverse-map; preserve with a literal marker if meant literally.", "location": {"offset": 78, "line": 3, "column": 22}, "term": "assemble", "source_term": "fuck", "literal_marker": "__SCM_LIT_assemble__"}, {"index": 1, "code": "ambiguous_target", "message": "Changed-line unmarked target will reverse-map; preserve with a literal marker if meant literally.", "location": {"offset": 2450, "line": 51, "column": 52}, "term": "assemble", "source_term": "fuck", "literal_marker": "__SCM_LIT_assemble__"}], "offset": 0, "next_offset": null, "findings_complete": true, "limits": "Diagnostics are operator evidence, not 