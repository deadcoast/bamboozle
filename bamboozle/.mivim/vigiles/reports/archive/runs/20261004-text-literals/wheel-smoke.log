n chunks:\r\n", "diff_complete": true}, {"path": "runner.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "064de56c3f25129a4f90ffc71cdd5d17ea06b4fe43ae9f24e863e312c9e51f21", "output_bytes": 1731, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,40 @@\n+import json\n+from parser import PREFIXES, EXAMPLES, FrameReader, fuck\n+from batch import RAW_EXAMPLE, summarize\n+\n+def frame(kind, value):\n+    return PREFIXES[kind] + value + \"__\"\n+\n+stream = frame(\"literal\", \"one\") + frame(\"case\", \"two\") + frame(\"literal\", \"one\") + frame(\"case\", \"\u6771\u4eac\")\n+expected = [(\"literal\", \"one\"), (\"case\", \"two\"), (\"literal\", \"one\"), (\"case\", \"\u6771\u4eac\")]\n+assert RAW_EXAMPLE == PREFIXES[\"literal\"]\n+assert EXAMPLES == (\"__SCM_LIT_unknown__\", \"__SCM_CASE_bad\", \"__scm_lit_\", \"__SCM_CASE__SCM_LIT_\")\n+split_cases = 0\n+for left in range(len(stream) + 1):\n+    for right in range(left, len(stream) + 1):\n+        assert fuck([stream[:left], stream[left:right], stream[right:]]) == expected\n+        split_cases += 1\n+assert fuck(iter(stream)) == expected\n+assert summarize(iter(stream)) == {\"case\": {\"two\": 1, \"\u6771\u4eac\": 1}, \"literal\": {\"one\": 2}}\n+assert fuck([frame(\"literal\", \"x\" * 64)]) == [(\"literal\", \"x\" * 64)]\n+assert fuck([]) == [] and summarize([]) == {}\n+bad_inputs = [\"bad\", frame(\"literal\", \"\"), frame(\"case\", \"x\" * 65), frame(\"literal\", \"line\\nbreak\"), PREFIXES[\"literal\"], frame(\"case\", \"item\")[:-1], frame(\"case\", \"item\")[:-1] + \"x\"]\n+for value in bad_inputs:\n+    reader = FrameReader(64)\n+    try:\n+        reader.feed(value)\n+        reader.finish()\n+    except ValueError:\n+        pass\n+    else:\n+        raise AssertionError(value)\n+    try:\n+        reader.feed(\"\")\n+    except ValueError:\n+        pass\n+    else:\n+        raise AssertionError(\"failure was not retained\")\n+    reader.reset()\n+    assert reader.feed(frame(\"literal\", \"ok\")) == [(\"literal\", \"ok\")]\n+    reader.finish()\n+print(json.dumps({\"split_cases\": split_cases, \"invalid_streams\": len(bad_inputs), \"frames\": len(expected), \"reset_after_failure\": True}))\n", "diff_complete": true}], "return_validation": {"status": "needs_review", "files": [{"path": "batch.py", "schema_version": 1, "validator_version": "2", "status": "needs_review", "ok": false, "decodable": true, "decoded_sha256": "14d8e3373f0a3207e382dfca10214f00579bb98e29c5f2479ff0e26b8b0e008e", "decode_policy": "saved_mapping_reserved_targets_before_manual_intent_decisions", "edited_sha256": "1d5904b09b5233bf6444e2a6d8d80858fe7f20b0ced0c9151405608412bd7807", "baseline_encoded_sha256": null, "dictionary_sha256": "3b4e57e2e14290c077405735dbeb75dc9109ba288bd5bd75d89f30667606562e", "document_rules": {"format": "text"}, "context_sha256": "ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356", "document_byte_limit": 16777216, "marker_version": 2, "validation_sha256": "b1653de638d1bbe79e4f836245e04b6f7bc4aeb0072f5bcb6ee23e76096498ba", "baseline_available": false, "analysis_complete": true, "finding_count": 2, "counts": {"ambiguous_target": 2}, "findings": [{"index": 0, "code": "ambiguous_target", "message": "Changed-line unmarked target will reverse-map; preserve with a literal marker if meant literally.", "location": {"offset": 51, "line": 2, "column": 20}, "term": "assemble", "source_term": "fuck", "literal_marker": "__SCM_LIT_assemble__"}, {"index": 1, "code": "ambiguous_target", "message": "Changed-line unmarked target will reverse-map; preserve with a literal marker if meant literally.", "location": {"offset": 158, "line": 7, "column": 12}, "term": "assemble", "source_term": "fuck", "literal_marker": "__SCM_LIT_assemble__"}], "offset": 0, "next_offset": null, "findings_complete": true, "limits": "Diagnostics are operator evidence, not inferred intent or semantic correctness. Changed-line target words can be vocabula