ty": 2, "critical": 8, "finish": {"a": 3, "b": 2, "c": 8}, "intervals": {"a": {"finish": 3, "start": 0, "worker": 0}, "b": {"finish": 2, "start": 0, "worker": 1}, "c": {"finish": 8, "start": 3, "worker": 0}}, "makespan": 8, "order": ["a", "b", "c"], "status": "planned", "total": 10}, "neutral_benchmark": {"invalid_capacities": 5, "invalid_workloads": 12, "protected_literals_preserved": true, "scheduler_executions": 300, "workloads": 100}, "returned": {"schema_version": 1, "status": "saved", "direction": "return", "view_id": "b5ae86b907354d199bfc42ec0f956364", "recipient": "owner", "output": "return.bam", "output_bytes": 58054, "exchange_sha256": "466d7138870f08e5af8813c24d6d903e03647744baa9ebdc84b7d48f4785bc57", "files": 8, "authenticated": true, "pipeline_sha256": "c8e31386d26327f89cf09d2d18b4509f922c50365a3f040ef2c13c746a1e2074", "output_saved": true}, "review": {"schema_version": 1, "view_id": "b5ae86b907354d199bfc42ec0f956364", "status": "review", "exchange_sha256": "466d7138870f08e5af8813c24d6d903e03647744baa9ebdc84b7d48f4785bc57", "ok": true, "delivery": {"header": {"key_id": "25fc7b0514f63a558078f2c169a1183c9fb3d411b4df4855b46eccb7ee0a5319", "kind": "vigiles.tessera", "schema_version": 2, "recipient": "owner", "issued_at": 1791138784, "algorithm": "AES-256-GCM", "sender": "receiver", "purpose": "project-return", "message_id": "02e30401f05c4d13b7fcb4bf616a2f59", "expires_at": 1791225184}, "packet_sha256": "466d7138870f08e5af8813c24d6d903e03647744baa9ebdc84b7d48f4785bc57", "payload_sha256": "d5a6f12e3a153cffa0b210a3e49ca09e9656184a41721db833382e10abe8ec92"}, "delivery_id": "700fdc2fefbcd5ab32d316d5cdb59f5d559c5fa38842dd1764000c607e04dd6b", "changes": [{"path": "bench.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "84997c6a5ad56b751c0cbd06da5551318da1ae5197e25219ad0036739d9689b8", "output_bytes": 2932, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,63 @@\n+import copy\n+import json\n+import random\n+from pipeline.main import run\n+from pipeline.graph import build, PROTOCOL_EXAMPLE, RESOURCE\n+\n+rng = random.Random(72831)\n+executions = 0\n+for size in range(1, 26):\n+    for repetition in range(4):\n+        rows = [{\"name\": str(index), \"weight\": rng.randrange(1, 13), \"dependencies\": [str(parent) for parent in range(index) if rng.random() < .18]} for index in range(size)]\n+        # Independent recurrence in generation order, separate from the returned\n+        # planner's heap traversal and event-driven capacity scheduler.\n+        ends = {}\n+        for row in rows:\n+            ends[row[\"name\"]] = max((ends[parent] for parent in row[\"dependencies\"]), default=0) + row[\"weight\"]\n+        for capacity in (1, 2, 32):\n+            result = run(rows, capacity)\n+            intervals = result[\"intervals\"]\n+            assert set(intervals) == set(ends)\n+            assert result[\"critical\"] == max(ends.values())\n+            assert result[\"total\"] == sum(row[\"weight\"] for row in rows)\n+            for row in rows:\n+                span = intervals[row[\"name\"]]\n+                assert span[\"finish\"] - span[\"start\"] == row[\"weight\"]\n+                assert all(intervals[parent][\"finish\"] <= span[\"start\"] for parent in row[\"dependencies\"])\n+            times = {item[\"start\"] for item in intervals.values()} | {item[\"finish\"] for item in intervals.values()}\n+            for moment in times:\n+                active = [item for item in intervals.values() if item[\"start\"] <= moment < item[\"finish\"]]\n+                assert len(active) <= capacity\n+                assert len({item[\"worker\"] for item in active}) == len(active)\n+            assert result[\"makespan\"] == max(item[\"finish\"] for item in intervals.values())\n+            if capacity == 1:\n+                assert result[\"makespan\"] == result[\"total\"]\n+            if capacity == 32:\n+                assert result[\"makespan\"] == result[\"critical\"]\n+            executions += 1\n+valid = [{\"name\": \"a\", \"weight\": 2, \"dependencies\": []}]\n+bad = [[], {}, valid + valid, [{\"name\":\"a\", \"weight\":2,\"dependencies\":[\"missing\"]}], [{\"name\":\"a\",\"weight\":2,\"dependencies\":[\"a\"]}]]\n+for value in (True, 0, -1, 1000001, \"2\", None):\n+    rows = copy.deepcopy(valid)\n+    rows[0][\"weight\"] = value\n+    bad.append(rows)\n+rows = copy.deepcopy(valid)\n+rows[0][\"dependencies\"] = [\"a\", \"a\"]\n+bad.append(rows)\n+for rows in bad:\n+    try:\n+        run(rows, 2)\n+    except ValueError:\n+        pass\n+    else:\n+        raise AssertionError(rows)\n+for capacity in (0, -1, True, 65, \"2\"):\n+    try:\n+        run(valid, capacity)\n+    except ValueError:\n+        pass\n+    else:\n+        raise AssertionError(capacity)\n+assert PROTOCOL_EXAMPLE == \"__SCM_LIT_bad__ __SCM_CASE_\"\n+assert RESOURCE == r\"C:\\models\\Task\\weight.json\"\n+print(json.dumps({\"workloads\":100,\"scheduler_executions\":executions,\"invalid_workloads\":len(bad),\"invalid_capacities\":5,\"protected_literals_preserved\":True}, sort_keys=True))\n", "diff_complete": true}, {"path": "obsolete.py", "policy": "translate", "action": "delete", "before_sha256": "63322b3a3fe7698a889ae0843b77277ceb31eaabfdf169f067b8e091878eebb0", "output_sha256": null, "output_bytes": 0, "diff": "--- retained-original\n+++ restored-edits\n@@ -1 +0,0 @@\n-OLD = True\n", "diff_complete": true}, {"path": "pipeline/main.py", "policy": "translate", "action": "modify", "before_sha256": "5720614a8ca6e12c78ecb47f1a1a37ff7e6e917298eb868f982360e6d461f61b", "output_sha256": "68f4a03881b3e22e2b82e1a0d658a4839d0f82c20c6ca79f34dbb92f3e9867fe", "output_bytes": 749, "diff": "--- retained-original\n+++ restored-edits\n@@ -1,17 +1,18 @@\n import argparse\n import json\n from pathlib import Path\n-from .graph import build\n+from .timeline import simulate\n \n-def run(rows):\n-    return build(rows)\n+def run(rows, capacity=2):\n+    return simulate(rows, capacity)\n \n def main():\n     parser = argparse.ArgumentParser(description=\"Validate and plan dependency workloads\")\n     parser.add_argument(\"input\")\n+    parser.add_argument(\"--capacity\", type=int, default=2)\n     args = parser.parse_args()\n     try:\n-        result = run(json.loads(Path(args.input).read_text(encoding=\"utf-8\")))\n+        result = run(json.loads(Path(args.input).read_text(encoding=\"utf-8\")), args.capacity)\n     except (ValueError, OSError) as error:\n         print(json.dumps({\"status\": \"invalid\", \"error\": str(error)}))\n         return 2\n", "diff_complete": true}, {"path": "pipeline/timeline.py", "policy": "translate", "action": "create", "before_sha256": null, "output_sha256": "7475b49a0a4081ddacad1a5ce1b68ac3ac96fc591f5d9492c3b0ea3a6cc44c9e", "output_bytes": 1227, "diff": "--- retained-original\n+++ restored-edits\n@@ -0,0 +1,30 @@\n+from heapq import heappop, heappush\n+from .model import load\n+from .graph import build\n+\n+def simulate(rows, capacity):\n+    if type(capacity) is not int or not 1 <= capacity <= 64:\n+        raise ValueError(\"capacity must be an integer from 1 to 64\")\n+    plan = build(rows)\n+    tasks = load(rows)\n+    completed, launched = set(), set()\n+    running, intervals = [], {}\n+    free = set(range(capacity))\n+    now = 0\n+    while len(completed) != len(tasks):\n+        ready = [name for name in plan[\"order\"] if name not in launched and set(tasks[name].dependencies) <= completed]\n+        for name in ready[:len(free)]:\n+            worker = min(free)\n+            free.remove(worker)\n+            launched.add(name)\n+            finish = now + tasks[name].weight\n+            intervals[name] = {\"start\": now, \"finish\": finish, \"worker\": worker}\n+            heappush(running, (finish, name, worker))\n+        if not running:\n+            raise ValueError(\"unschedulable workload\")\n+        now = running[0][0]\n+        while running and running[0][0] == now:\n+            _, name, worker = heappop(running)\n+            completed.add(name)\n+            free.add(worker)\n+    return {**plan, \"makespan\": now, \"intervals\": intervals, \"capacity\": capacity}\n", "diff_complete": true}], "return_validation": {"status": "needs_review", "files": [{"path": "bench.py", "schema_version": 1, "validator_version": "2", "status": "accepted", "ok": true, "decodable": true, "decoded_sha256": "84997c6a5ad56b751c0cbd06da5551318da1ae5197e25219ad0036739d9689b8", "decode_policy": "saved_mapping_reserved_targets_before_manual_intent_decisions", "edited_sha256": "135e82b621edc6733c9e274cc1953e5530114d906ed806c716703ec30d12bc78", "baseline_encoded_sha256": null, "dictionary_sha256": "7a0930454c59e28dfd2d2a8afaefe9d72947d9bf1cb5e8984598a76f7ba382cf", "document_rules": {"format": "python", "identifiers": ["Task", "build", "run", "weight", "total"], "modules": [".model", ".graph", ".timeline", "pipeline.model", "pipeline.graph", "pipeline.main", "pipeline.timeline"], "strings": ["build"]}, "context_sha256": "ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356", "document_byte_limit": 16777216, "marker_version": 2, "validation_sha256": "5af8524129b404f3571682e92664f377f8fad888cabe51ad6e26e63b9b3236ca", "baseline_available": false, "analysis_complete": true, "finding_count": 0, "counts": {}, "findings": [], "offset": 0, "next_offset": null, "findings_complete": true, "limits": "Diagnostics are operator evidence, not inferred intent or semantic correctness. Changed-line target words can be vocabulary or literals. Missing terms/markers may be intentional deletion. Variant hints cover simple ASCII word suffixes and underscore identifiers only; synonyms, arbitrary spelling changes, multiword phrase variants and other languages are not inferred. Protected-content changes require review, not automatic rejection.", "output_saved": false}, {"path": "pipeline/__init__.py", "schema_version": 1, "validator_version": "2", "status": "accepted", "ok"