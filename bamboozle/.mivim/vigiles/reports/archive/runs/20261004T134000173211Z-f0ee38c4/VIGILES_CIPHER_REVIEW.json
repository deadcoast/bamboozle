  "design": [
    "Retain original C source/build/license assets and checkpoint hashes as primary method references",
    "Implement the 11 supplied algorithm families as callable byte-safe versioned product transforms, with explicit incompatibilities for formerly lossy cases",
    "Expose complete recipes and forward/reverse file operations through existing reviewed publisher; no replacement of semantic dictionary engines or authenticated ciphers",
    "Keep recipes and receipts private to operator/source boundaries; do not offer classical obfuscation as authenticated confidentiality",
    "Execute known vectors, original C comparisons, binary/property/error tests, actual CLI/MCP file exchange and dependent application restoration from installed wheel"
  ],
  "findings": [
    {
      "action": "Length-preserving ragged transposition with exact inverse positions",
      "id": "C-01",
      "issue": "Padding removal strips actual trailing tildes; empty/all-padding return can lack terminator",
      "source": "src/ciphers/scytale.c"
    },
    {
      "action": "Stable duplicate-key order, explicit key validation, no padding, invertible ragged columns",
      "id": "C-02",
      "issue": "Undelimited underscore padding loses original length; empty keyword divides by zero; ragged decoder leaves uninitialized bytes",
      "source": "src/ciphers/columnar_transposition.c"
    },
    {
      "action": "Explicit versioned byte framing for case, I/J and every nonalphabet byte; strict decoder rejects noncanonical tokens",
      "id": "C-03",
      "issue": "Case and I/J are merged; literal digits/whitespace are ambiguous; malformed decode can exceed allocated buffer",
      "source": "src/ciphers/polybius_square.c"
    },
    {
      "action": "Normalize modular parameters before arithmetic; bounded keys and input-linear inverse permutations",
      "id": "C-04",
      "issue": "Signed minimum negation, unnormalized multiplication and large rail arithmetic can overflow",
      "source": "src/ciphers/caesar.c, src/ciphers/affine.c, src/ciphers/rail_fence.c"
    },
    {
      "action": "Packaged immutable capability registry and reviewed bounded file pipeline with explicit versioned recipes, receipts, verify/recovery and no compiler requirement",
      "id": "C-05",
      "issue": "Registry separates implementations well, but interactive-only C entry is absent from product CLI/MCP, has no file contracts or provenance",
      "source": "src/cipher.c, src/main.c"
    },
    {
      "action": "Product-owned capability discovery shared by CLI/operator MCP and Vandal; semantic/classical/authenticated operations distinct",
      "id": "C-06",
      "issue": "Workflow lacks routing/capabilities for supplied cipher family",
      "source": "scripts/vandal.py"
    }
  ],
