            "diff": "--- retained-original\n+++ restored-edits\n@@ -1,17 +1,18 @@\n import argparse\n import json\n from pathlib import Path\n-from .graph import build\n+from .timeline import simulate\n \n-def run(rows):\n-    return build(rows)\n+def run(rows, capacity=2):\n+    return simulate(rows, capacity)\n \n def main():\n     parser = argparse.ArgumentParser(description=\"Validate and plan dependency workloads\")\n     parser.add_argument(\"input\")\n+    parser.add_argument(\"--capacity\", type=int, default=2)\n     args = parser.parse_args()\n     try:\n-        result = run(json.loads(Path(args.input).read_text(encoding=\"utf-8\")))\n+        result = run(json.loads(Path(args.input).read_text(encoding=\"utf-8\")), args.capacity)\n     except (ValueError, OSError) as error:\n         print(json.dumps({\"status\": \"invalid\", \"error\": str(error)}))\n         return 2\n",
