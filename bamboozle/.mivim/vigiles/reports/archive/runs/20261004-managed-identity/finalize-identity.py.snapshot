from pathlib import Path
import hashlib
import json
from datetime import UTC, datetime
from bamboozle.evidence import report_destination, write_report
from bamboozle.utils import json_bytes

root = Path.cwd()
archive = root / ".mivim/vigiles/reports/archive/runs/20261004-managed-identity"
verification_path = root / ".mivim/vigiles/reports/current/VIGILES_VERIFICATION.json"
verification = json.loads(verification_path.read_bytes())
assert verification["status"] == "passed" and verification["package_requested"]
assert len(verification["steps"]) == 12
assert verification["tests"] == {"errors": 0, "failures": 0, "skipped": 0, "tests": 1267}
for name, expected in verification["source_sha256"].items():
    assert hashlib.sha256((root / name).read_bytes()).hexdigest() == expected, name
for name in verification["required_artifacts"]:
    assert hashlib.sha256((root / "dist" / name).read_bytes()).hexdigest() == verification["artifacts"][name]["sha256"]
wheel = next(step for step in verification["steps"] if step["name"] == "wheel-smoke")
installed, _ = json.JSONDecoder().raw_decode((root / wheel["log"]).read_text(encoding="utf-8"))
assert installed["status"] == "passed"
proof = installed["identity_results"]
for flow in proof["applications"]["workflows"].values():
    assert flow["restored_benchmark"] == flow["neutral_benchmark"]
    assert flow["restored_benchmark"]["scheduler_executions"] == 300
    assert flow["apply"]["receipt_saved"] and flow["opened"]["receipt_saved"]
implementation = [
    "src/bamboozle/identity.py", "src/bamboozle/transport.py", "src/bamboozle/tessera.py",
    "src/bamboozle/project_exchange.py", "src/bamboozle/view_import.py", "src/bamboozle/cli.py",
    "src/bamboozle/mcp.py", "src/bamboozle/cipher_operations.py", "scripts/vandal.py",
    "scripts/identity_smoke.py", "scripts/exchange_smoke.py", "scripts/package_smoke.py",
    "src/bamboozle/tests/test_identity.py", "src/bamboozle/tests/test_cli_mcp.py", "src/bamboozle/tests/test_vandal.py",
]
scope = "Local managed recipient lifecycle and replay-aware file/project delivery through CLI and actual operator stdio MCP; complete neutral/restored dependent applications from source and installed wheel; key rotation/revocation, competing processes, partial publication/recovery and truthful retained-state reporting."
report = {
    "schema_version": 1, "id": "VIG-IDENTITY-01", "completed": datetime.now(UTC).isoformat(),
    "status": "source_and_installed_application_verified", "scope": scope,
    "release": "0.7.0", "workflow": "vigiles-vandal_0.2",
    "implementation": implementation,
    "source_sha256": {name: verification["source_sha256"][name] for name in implementation},
    "contract": "docs/managed-transport.md",
    "contract_sha256": hashlib.sha256((root / "docs/managed-transport.md").read_bytes()).hexdigest(),
    "design": {
        "sources": [".mivim/vigiles/specs/vigiles-vanilla_0.1.md:63-66", ".mivim/vigiles/specs/vigiles-vanilla_0.1.md:171", ".mivim/vigiles-vandal_0.2.md", "VIGILES_STATUS.json"],
        "ownership": "Bamboozle implements custody, versioned Tessera and journal-bound admission; Vandal routes operator capabilities and keeps them outside source-agent contexts.",
        "compatibility": "Explicit schema-1 raw-key transport and original C method assets preserved; schema-2 managed transport never downgrades. Semantic/classical/BAMb5 engines remain distinct.",
        "trust": "Operator-owned local shared-key bindings, private durable state, trustworthy clock and explicit out-of-band pair-key provisioning; not independent identity verification."
    },
    "verification": {"report": str(verification_path.relative_to(root)), "created": verification["created"], "stages": len(verification["steps"]), "tests": verification["tests"], "python": verification["python"], "platform": verification["platform"], "logs": {step["name"]: step["log"] for step in verification["steps"]}},
    "installed_application": proof,
    "artifacts": {name: verification["artifacts"][name] for name in verification["required_artifacts"]},
    "focused_regressions": ["Tampered headers/nonces/ciphertexts, sender/recipient/purpose/version mismatch and no unauthenticated admission", "Stale lifecycle digests, pair-key reuse refusal, terminal revocation and retirement issue cutoff", "Expiry/future-clock refusal; exact pending recovery after expiry and revocation blocking recovery", "Serialized replay and competing process admission", "Read-only repeated review, no-edit return admission, source review/apply binding and packet-free retained source recovery", "File/extraction/source interruption, admission crash boundary and retained completion receipts", "No-clobber refusal reports pre-existing files truthfully; send key-byte drift and custody-close errors preserve publication evidence"],
    "preserved_evidence": str(archive.relative_to(root)),
    "limitations": ["Remote identity verification and key delivery remain operator responsibilities", "No global replay coordination across cloned roots or protection against administrative state/clock rollback", "No live key custody ACLs, remote CI matrix or production host isolation acceptance established"],
    "next_core_finding": ".mivim/vigiles/reports/archive/runs/20261004-managed-identity/next-core-finding.json"
}
destination = report_destination(root, "VIGILES_IDENTITY_QUALIFICATION.json")
write_report(root, destination, report)
status_path = root / "VIGILES_STATUS.json"
status = json.loads(status_path.read_bytes())
completed = status["next_step"]
completed.update(status="source_and_installed_application_verified", implementation=implementation,
                 evidence=[str(destination.relative_to(root))], qualification={"scope":scope,"stages":12,"tests":verification["tests"]})
status["last_completed_step"] = completed
next_step = json.loads((archive / "next-core-plan.json").read_bytes())
status["next_step"] = next_step
status["core_development_queue"] = [next_step]
status["core_acceptance"] = {"status":"not_established", "reason":"Managed local delivery and complete source/installed application workflows are qualified. Original literal path/URL protection and the documented external acceptance gates remain open."}
status["evidence"]["identity_qualification"] = str(destination.relative_to(root))
status["evidence"]["qualification_scope"] = scope
status["evidence"]["prior_identity_iteration"] = str((archive / "interim-VIGILES_VERIFICATION.json").relative_to(root))
for gate in status["open_gates"]:
    if gate["id"] == "VIG-IDENTITY-01":
        gate.update(status="local_implementation_qualified_external_trust_open",
                    completed_stage="Isolated local identities, pair-key registration/rotation/retirement/revocation, expiry, persistent replay admission, exact pending recovery and complete source/installed file/project applications qualified.",
                    impact="Local key possession and configured peer bindings are qualified; independent identity verification, remote provisioning/custody and replicated replay policy are not established.",
                    next_action="For an operator-selected remote deployment, establish authenticated peer/key provisioning, custody ACLs, trusted time and cross-host replay/backup rules; this does not block the next core translator task.",
                    dependencies=["Authenticated out-of-band peer/key provisioning", "Operator key custody and host policy", "Cross-host replay and backup/clock rollback policy"],
                    done_criteria=["Isolated local recipient, rotation/revocation and replay tests (complete)", "No key bytes in reports or neutral views (complete for qualified paths)", "External peer identity, key distribution/custody and replicated-state acceptance (open)"],
                    evidence=[str(destination.relative_to(root))])
write_report(root, status_path, status, replace=True)
review = json.loads((archive / "final-review.json").read_bytes())
review["status"] = "corrected_and_verified"
review["evidence"] = str(destination.relative_to(root))
write_report(root, archive / "final-review-result.json", review)
print(json.dumps({"status":report["status"],"tests":verification["tests"],"stages":12,"next_step":next_step["id"],"evidence":str(destination.relative_to(root))}))
